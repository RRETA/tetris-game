    "typecheck": "tsc -p tsconfig.json --noEmit",
    "audit": "pnpm audit --audit-level high"
  },
  "dependencies": {
    "@vitejs/plugin-react": "^5.2.0",
    "react": "^19.2.3",
    "react-dom": "^19.2.3"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.2.2",
    "@types/node": "^24.10.0",
    "@types/react": "^19.2.7",
    "@types/react-dom": "^19.2.3",
    "tailwindcss": "^4.2.2",
    "tw-animate-css": "^1.4.0",
    "typescript": "^5.9.3",
    "vite": "^7.2.7"
  },
  "packageManager": "pnpm@10.25.0",
  "engines": {
    "node": ">=20.19.0"
  }
